# PostgreSQL connection string (Supabase pooler, transaction mode)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# Supabase project URL — server-side (for image URLs generated in Route Handlers)
SUPABASE_URL=https://your-project.supabase.co

# Supabase project URL — client-side (for ingredient images in client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
